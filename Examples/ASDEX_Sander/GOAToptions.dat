'GAoptions.bunch_tria'      '0'
'GAoptions.bunch_pent'      '0'
'GAoptions.BLG'             '0'
'GAoptions.BLG_n_layers'    '1'
'GAoptions.splitting'       '0'
'GAoptions.merging'         '1'
'GAoptions.pents_to_tria'   '1'
'GAoptions.merging2'        '0'

# Splitting options
'GAoptions.no_pents'         '1'
'GAoptions.splittype'        'rad'
'GAoptions.n_split'          '20'
'GAoptions.typeT'            'cutcell'
'GAoptions.rad_type'         'h_rad'
'GAoptions.pol_type'         'trias'
'GAoptions.dist_function_threshold_split' '0.9'

# Merging options
'GAoptions.no_hex'           '1'
'GAoptions.merg_crit'        'h_pol'
'GAoptions.merge_h_pol_factor' '1.5'
'GAoptions.n_merg'           '100'
'GAoptions.dist_function_threshold_merge' '0.8'
