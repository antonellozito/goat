# Script to initialize openmp variables. 
# Note: OMP_NUM_THREADS (number of threads per process) should be 
# set by the calling script
setenv OMP_DISPLAY_AFFINITY true 
setenv OMP_DISPLAY_ENV verbose
setenv OMP_PLACES cores
setenv OMP_PROC_BIND true

# We don't yet allow multilevel parallellism
setenv OMP_MAX_ACTIVE_LEVELS 1

